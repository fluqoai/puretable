# Supabase public configuration
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only. Never prefix this key with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-secret-key"
CRON_SECRET="generate-a-long-random-secret"

# Google Maps: use separate keys. The server key must enable Places API (New)
# and must not have an HTTP-referrer restriction.
GOOGLE_MAPS_API_KEY="your-server-side-places-key"
# Public browser key: restrict it by the deployed site's HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY="your-browser-maps-key"

# Optional integrations
VITE_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
APP_URL="http://localhost:3000"
