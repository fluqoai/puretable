# Supabase public configuration
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only. Never prefix this key with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-secret-key"
CRON_SECRET="generate-a-long-random-secret"

# Public Mapbox token: restrict allowed URLs in your Mapbox account.
VITE_MAPBOX_ACCESS_TOKEN="your-public-mapbox-token"

# PostHog project ingestion key, not a personal API token.
VITE_POSTHOG_KEY="your-posthog-project-key"
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
APP_URL="http://localhost:3000"

# Transactional email (server-only). The Resend key must never use a VITE_ prefix.
RESEND_API_KEY="re_your-server-side-key"
EMAIL_FROM="PureTable <no-reply@puretable.co>"
EMAIL_ADMIN_RECIPIENT="info@puretable.co"
